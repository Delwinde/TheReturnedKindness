# The password you'll type in at /admin to manage the site.
# Set this in Vercel: Project Settings -> Environment Variables.
ADMIN_PASSWORD=choose-a-strong-password

# These two are added automatically when you attach a database (Upstash
# Redis, using the "KV" prefix) to your project from the Storage tab.
# You do not need to set them by hand on Vercel. For local development
# without one connected, the app falls back to temporary in-memory storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Added automatically when you attach a Vercel Blob store (Storage tab ->
# Create Database -> Blob) to your project. Needed for photo uploads in
# the admin dashboard.
BLOB_READ_WRITE_TOKEN=
