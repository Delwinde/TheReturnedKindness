# The password you'll type in at /admin to manage the site.
# Set this in Vercel: Project Settings -> Environment Variables.
ADMIN_PASSWORD=choose-a-strong-password

# These two are added automatically when you attach a Vercel KV database
# to your project (Storage tab -> Create Database -> KV). You do not need
# to set them by hand on Vercel. For local development without a KV
# database, the app falls back to temporary in-memory storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
